# Point this at your backend. For local dev use your machine's LAN IP
# (not localhost) so a physical device/simulator can reach it.
EXPO_PUBLIC_API_BASE_URL="http://192.168.1.100:4000"

# Stripe publishable key (safe to expose in the app - this is NOT the secret key)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"
