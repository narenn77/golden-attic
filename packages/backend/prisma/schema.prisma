generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users ----------

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  phone                 String?
  name                  String
  passwordHash          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Email verification
  emailVerified             Boolean   @default(false)
  emailVerificationToken     String?   @unique
  emailVerificationExpires   DateTime?

  // Password reset
  passwordResetToken         String?   @unique
  passwordResetExpires       DateTime?

  // Seller-related
  isSeller              Boolean  @default(false)
  stripeConnectAccountId String? @unique  // for receiving payouts as a seller
  stripeCustomerId      String?  @unique  // for making payments as a buyer

  // Address - used as a seller's ship-from location and pre-filled as a
  // buyer's default ship-to address at checkout (checkout can override it
  // per-order without changing this saved default). One address per user
  // for now, not multiple saved addresses - kept simple for v1.
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  postalCode            String?
  country               String?  @default("US")

  listings              Listing[] @relation("SellerListings")
  bidsMade              Bid[]     @relation("BidderBids")
  ordersAsBuyer         Order[]   @relation("BuyerOrders")
  ordersAsSeller        Order[]   @relation("SellerOrders")
  likes                 Like[]
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  messages              Message[]
  ratingsGiven          Rating[] @relation("RatingsGiven")
  ratingsReceived       Rating[] @relation("RatingsReceived")

  @@index([email])
}

// ---------- Listings ----------

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD
  EXPIRED
  REMOVED
}

model Listing {
  id                String        @id @default(uuid())
  sellerId          String
  seller            User          @relation("SellerListings", fields: [sellerId], references: [id])

  title             String
  description       String
  category          String
  price             Decimal       @db.Decimal(10, 2)
  images            String[]      // URLs to stored images
  status            ListingStatus @default(DRAFT)

  // AI-assisted listing metadata
  aiGenerated        Boolean      @default(false)
  aiSuggestedTitle   String?
  aiSuggestedPrice   Decimal?     @db.Decimal(10, 2)
  aiSuggestedCategory String?

  // Hosting / monetization lifecycle
  publishedAt       DateTime?     // when it went ACTIVE
  freeUntil         DateTime?     // end of first free hosting month
  hostingPaidUntil  DateTime?     // hosting fee paid through this date
  soldAt            DateTime?
  pausedAt          DateTime?     // when the seller paused it - paused listings are
                                  // hidden from browsing and auto-removed ~30 days later
  expiryWarningSentAt DateTime?   // when we last emailed a free-hosting-expiring warning,
                                  // so the maintenance job never sends it twice

  // Provenance fields - especially valuable for stamps, coins, currency.
  // Not applicable to every category, so both are optional.
  year              Int?          // year of issue/manufacture
  country           String?       // country of origin

  // Shipping - optional; when absent, checkout falls back to a
  // conservative default weight band for the rate estimate.
  weightOz          Int?          // package weight in ounces

  allowBidding      Boolean       @default(true)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  bids              Bid[]
  orders            Order[]
  hostingFees       HostingFee[]
  likes             Like[]
  conversations     Conversation[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([country])
  @@index([year])
}

// ---------- Likes / Saves ----------
// One system, two names people use interchangeably - a buyer "liking" or
// "saving" an item is the same action: a row in this table.

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, listingId]) // a user can only like a listing once
  @@index([listingId])
  @@index([userId])
}

// ---------- Bidding ----------

enum BidStatus {
  PENDING     // buyer placed a bid, awaiting seller response
  COUNTERED   // seller offered a lower price back to buyer
  ACCEPTED    // bid (or counter) accepted, ready to check out
  REJECTED
  WITHDRAWN
}

model Bid {
  id            String    @id @default(uuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id])
  bidderId      String
  bidder        User      @relation("BidderBids", fields: [bidderId], references: [id])

  amount        Decimal   @db.Decimal(10, 2)
  counterAmount Decimal?  @db.Decimal(10, 2) // set when seller counters
  status        BidStatus @default(PENDING)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([listingId])
  @@index([bidderId])
}

// ---------- Orders / Payments ----------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

model Order {
  id                   String      @id @default(uuid())
  listingId            String
  listing              Listing     @relation(fields: [listingId], references: [id])
  buyerId              String
  buyer                User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId             String
  seller               User        @relation("SellerOrders", fields: [sellerId], references: [id])

  amount               Decimal     @db.Decimal(10, 2) // item price only
  commissionAmount     Decimal     @db.Decimal(10, 2) // platform's cut (on item price only, not shipping)
  sellerPayoutAmount   Decimal     @db.Decimal(10, 2) // amount - commission

  // Shipping - either a shipping address + calculated cost, or a local
  // pickup arrangement (agreed via chat) with zero shipping cost.
  localPickup           Boolean    @default(false)
  shippingCost           Decimal?  @db.Decimal(10, 2)
  shippingAddressLine1   String?
  shippingAddressLine2   String?
  shippingCity           String?
  shippingState          String?
  shippingPostalCode     String?
  shippingCountry        String?

  stripePaymentIntentId String?    @unique
  stripeTransferId      String?    // transfer to seller's connected account

  status               OrderStatus @default(PENDING_PAYMENT)

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  ratings              Rating[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
}

// ---------- Ratings ----------
// Trust signal for both sides. Deliberately restricted to participants of
// a COMPLETED order - anyone else rating would just be gameable noise.

model Rating {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  raterId       String
  rater         User     @relation("RatingsGiven", fields: [raterId], references: [id])
  ratedUserId   String
  ratedUser     User     @relation("RatingsReceived", fields: [ratedUserId], references: [id])

  score         Int      // 1-5
  comment       String?

  createdAt     DateTime @default(now())

  @@unique([orderId, raterId]) // one rating per person per order (buyer and seller each rate once)
  @@index([ratedUserId])
}

// ---------- Messaging ----------
// One conversation per (listing, buyer) pair - keeps every conversation
// anchored to a specific item, which is what buyers and sellers are
// actually discussing (the item itself, shipping vs. local pickup, etc).

model Conversation {
  id        String    @id @default(uuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId  String
  seller    User      @relation("SellerConversations", fields: [sellerId], references: [id])

  messages  Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ---------- Hosting fees (1%/month after first free month) ----------

model HostingFee {
  id                String   @id @default(uuid())
  listingId         String
  listing           Listing  @relation(fields: [listingId], references: [id])

  periodStart       DateTime
  periodEnd         DateTime
  amount            Decimal  @db.Decimal(10, 2)
  paid              Boolean  @default(false)
  stripeInvoiceId   String?

  createdAt         DateTime @default(now())

  @@index([listingId])
}
